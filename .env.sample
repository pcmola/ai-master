# Copy this file to .env and fill in real values locally.
# Never commit .env or real credentials.
# All tools read this single .env at the project root.

# Azure DevOps (wiki_tools/wiki_documents.py, proxy_tools/proxy_policy_publish.py)
# PAT scopes: Wiki (Read & write), Work Items (Read & write), Code (Read & write)
AZURE_DEVOPS_ORG=ai-master
AZURE_DEVOPS_PROJECT="AI Master"
AZURE_DEVOPS_WIKI=AI-Master.wiki
AZURE_DEVOPS_PAT=replace-with-azure-devops-pat

# Azure OpenAI-compatible gateway (wiki_tools/wiki_search.py: guide LLM + search embeddings)
AZURE_OPENAI_ENDPOINT=https://your-gateway.example.com
AZURE_OPENAI_API_KEY=replace-with-api-key
OPENAI_API_VERSION=2024-12-01-preview
OPENAI_MODEL=gpt-6.1-sol
OPENAI_EMBED_MODEL=text-embedding-3-large
# Weight of embedding similarity in hybrid search (keyword score + EMBED_WEIGHT * similarity)
EMBED_WEIGHT=8
# Local wiki viewer address used for links in search results.
# Leave empty to follow the hosts file (http://wiki.local, or http://127.0.0.1:8765 if not registered)
WIKI_VIEWER_URL=

# Web search for wiki_tools/wiki_search.py
# Used only when wiki evidence is weak: best embedding similarity < WEB_SEARCH_MIN_SIM, or no matching wiki docs.
# WEB_SEARCH_PROVIDER: auto (Tavily if TAVILY_API_KEY is set, else GPT web_search via the LLM gateway), tavily, gpt, off
WEB_SEARCH_PROVIDER=auto
# https://tavily.com (optional)
TAVILY_API_KEY=
# GPT web search uses the Responses API: Azure needs api-version 2025-03-01-preview or later
WEB_SEARCH_API_VERSION=2025-04-01-preview
WEB_SEARCH_MIN_SIM=0.5
# When a type (e.g. reverse proxy) is chosen: web search if the type name alone is less similar than this
WEB_SEARCH_MIN_VARIANT_SIM=0.45
WEB_SEARCH_MAX=5
# Scenario 1 RAG: chunks passed to the LLM (count, approx size of one chunk, total chars)
GUIDE_CHUNKS=24
GUIDE_CHUNK_CHARS=1500
GUIDE_CONTEXT_CHARS=16000
# Days to keep per-request trace files in data/traces/ (wiki_search.py)
TRACE_KEEP_DAYS=14
# Scenario 1: push to Azure DevOps Wiki when "Wiki에 등록" is clicked (0 = local commit only)
WIKI_REGISTER_PUSH=1

# Optional providers for wiki_tools/wiki_search.py (Claude is used first when its key is set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Scenario 3: proxy incident response (proxy_tools/incident_response.py)
# Look at the last N minutes of logs; approval wait (seconds); backlog for the Task
SCENARIO3_WINDOW_MIN=60
SCENARIO3_TIMEOUT=900
SCENARIO3_EPIC_ID=1
SCENARIO3_FEATURE=[공통] 프록시 장애 대응
SCENARIO3_PBI=프록시 장애 대응
# Local clone of the Squid config repo (Azure Repos proxy-config). Empty = ../proxy-config
PROXY_CONFIG_DIR=

# Proxy VM access (proxy_tools/proxy_policy_monitor.py, proxy_policy_publish.py). VMs are found like scenario 2 (tag or name rule).
# Clients allowed to use the proxy (comma-separated CIDR). Used by proxy_log_detect.py and proxy_fault_inject.py
PROXY_ALLOWED_CLIENTS=203.0.113.10/32
PROXY_SSH_USER=azureuser
# Leave empty to use the default SSH key (~/.ssh/id_rsa)
PROXY_SSH_KEY=
# Container runtime of Squid on the VM (proxy_log_viewer.py): podman or docker
SQUID_RUNTIME=podman

# Microsoft Teams (teams_tools/, test/teams_test.py) - requires a work/school Microsoft 365 account. Never put a password here.
# TEAMS_WEBHOOK_URL: Teams channel/chat > ... > Workflows > 'Send webhook alerts to a channel' (copy the whole URL)
# TEAMS_CLIENT_ID / TEAMS_TENANT_ID: Microsoft Entra ID > App registrations > your app > Overview
TEAMS_WEBHOOK_URL=
# TEAMS_MENTION: user to @mention on each card so it shows in the Teams Activity feed (UPN, e.g. user@contoso.onmicrosoft.com)
TEAMS_MENTION=
TEAMS_MENTION_NAME=
TEAMS_CLIENT_ID=
TEAMS_TENANT_ID=

# Scenario 2: Proxy status wiki sync (proxy_tools/proxy_status_sync.py, test/scenario2/setup_env.py)
# Resource group to compare and the Task assignee (empty = PAT owner)
SCENARIO2_RESOURCE_GROUP=WJY-PROXY-RG
SCENARIO2_ASSIGNEE=
# VMs with this tag are proxies regardless of name ('key=value' or 'key'); others fall back to the name rule
SCENARIO2_TAG=role=proxy
# VMs marked 'not a proxy' on the approval page get this tag and are skipped even if the name matches
SCENARIO2_EXCLUDE_TAG=role=not-proxy
# Backlog the Task goes under: Epic id -> Feature title -> monthly PBI ('YYMM) ' + title)
SCENARIO2_EPIC_ID=1
SCENARIO2_FEATURE=[공통] Proxy 현황 관리
SCENARIO2_PBI=Proxy VM 현황 Wiki 현행화
# After approval: 0 = commit to wiki-repo only (default), 1 = also push to Azure DevOps Wiki
SCENARIO2_PUSH=0
# Approval wait in seconds, and the wiki page to compare (path under wiki-repo, empty = test page)
SCENARIO2_TIMEOUT=900
SCENARIO2_WIKI_PAGE=
