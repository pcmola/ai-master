# Copy this file to .env and fill in real values locally.
# Never commit .env or real credentials.

# Azure DevOps Wiki
AZURE_DEVOPS_ORG=ai-master
AZURE_DEVOPS_PROJECT="AI Master"
AZURE_DEVOPS_WIKI=AI-Master.wiki
AZURE_DEVOPS_PAT=replace-with-azure-devops-pat

# Azure OpenAI-compatible gateway
AZURE_OPENAI_ENDPOINT=https://skax.ai-talentlab.com
AZURE_OPENAI_API_KEY=replace-with-api-key
OPENAI_API_VERSION=2024-12-01-preview
OPENAI_MODEL=gpt-4.1
OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional provider credentials used by wiki_search.py
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Squid policy monitor (read-only SSH access)
SQUID_HOST=wjy-proxy01
SQUID_SSH_USER=azureuser
SQUID_SSH_KEY=
SQUID_POLICY_ROOT=/etc/squid
SQUID_POLICY_SNAPSHOT=.proxy_policy_state/wjy-proxy01.json
